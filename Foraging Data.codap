1,"componentStorage":{"isActive":true,"horizontalScrollOffset":0,"_links_":{"context":{"type":"DG.DataContextRecord","id":2871}},"attributeWidths":[{"_links_":{"attr":{"type":"DG.Attribute","id":2873}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2874}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2875}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2876}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2877}},"width":69},{"_links_":{"attr":{"type":"DG.Attribute","id":2878}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2879}},"width":60},{"_links_":{"attr":{"type":"DG.Attribute","id":2880}},"width":119}],"rowHeights":[],"title":"Weathers","userSetTitle":true,"cannotClose":false},"layout":{"width":614,"height":275,"zIndex":1678,"left":430,"top":740,"isVisible":false,"right":510,"bottom":405},"savedHeight":null},{"type":"DG.TableView","guid":3343,"id":3343,"componentStorage":{"isActive":true,"horizontalScrollOffset":0,"_links_":{"context":{"type":"DG.DataContextRecord","id":3332}},"attributeWidths":[{"_links_":{"attr":{"type":"DG.Attribute","id":3342}},"width":54}],"rowHeights":[],"title":"Patch Levels","userSetTitle":true,"cannotClose":false},"layout":{"width":615,"height":250,"zIndex":2193,"left":895,"top":780,"isVisible":true,"right":1455,"bottom":1080},"savedHeight":null},{"type":"DG.TextView","guid":6187,"id":6187,"componentStorage":{"text":"{\"object\":\"value\",\"document\":{\"children\":[{\"type\":\"paragraph\",\"children\":[{\"text\":\"Resource Types\",\"bold\":true},{\"text\":\" are the 16 resources that can be foraged.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"All Player Foraging Log \",\"bold\":true},{\"text\":\"are the records of all times that players foraged a resource.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"Weathers \",\"bold\":true},{\"text\":\"shows the weather on each island on each day.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"Patch Levels \",\"bold\":true},{\"text\":\"show the four energy levels at each foraging patch. Data points are recorded at each foraging event.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"Questions:\",\"bold\":true}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"1a) Spring AM Early. You need any Sweet resource variety to craft a food. Where do you go?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"1b) What Type of resource were you most likely to get in part A (a Plant, Rock, Bug or Mushroom)?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"2a) Spring AM Early. You need Powdered Sugar to craft a Cupcake. Where do you go?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"3) Foods are made with a Fruit and Sweet variety ingredient (of any Type). What kinds of Fruits are most available in the Spring? What kinds of Sweets?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"2b) Spring AM Early. You want a 100% quality resource... where should you go?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}],\"objTypes\":{\"paragraph\":\"block\"}}}","title":"Intro","name":"Text","userSetTitle":true,"cannotClose":false},"layout":{"width":415,"height":155,"zIndex":2142,"left":10,"top":30,"isVisible":true,"right":510,"bottom":195},"savedHeight":null},{"type":"DG.GraphView","guid":6188,"id":6188,"componentStorage":{"_links_":{"context":{"type":"DG.DataContextRecord","id":3},"legendColl":{"type":"DG.Collection","id":4},"legendAttr":{"type":"DG.Attribute","id":10},"hiddenCases":[],"xColl":{"type":"DG.Collecti