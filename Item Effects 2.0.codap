,\"document\":{\"children\":[{\"type\":\"paragraph\",\"children\":[{\"text\":\"1. Who likes which foods\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"2. Specialize in a subtype: which faction likes which subtypes?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"3. Specialize in a Faction: which subtypes does this faction like?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"FILTERING IS SPECIALIZING\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"We're now at a point that we can't see any more information. What do we do? Level up!\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"LEVELING UP IS SEEING NEW INFO, NEW PATTERN\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"6. Back up a level-- what generalizes to other factions?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"OR what generalizes for this faction, across other foods?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"6a. Incentivize \\\"bad\\\" cupcakes? Completion goals!\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"6b. Why do Stability and Shadow have fewer cupcakes? Resource scarcity\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"7. Complete the pattern-- what does B style favorite?\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"8. Growth and Stability are opposites! \"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"Learn from E-- who is E like?\"}]}],\"objTypes\":{\"paragraph\":\"block\"}}}","title":"Text","name":"Text","userSetTitle":false,"cannotClose":false},"layout":{"width":375,"height":25,"zIndex":3310,"left":575,"top":355,"isVisible":true,"right":950,"bottom":380},"savedHeight":550},{"type":"DG.GraphView","guid":3183,"id":3183,"componentStorage":{"_links_":{"context":{"type":"DG.DataContextRecord","id":2222},"legendColl":{"type":"DG.Collection","id":2223},"legendAttr":{"type":"DG.Attribute","id":2238},"hiddenCases":[{"type":"DG.Case","id":2953},{"type":"DG.Case","id":2954},{"type":"DG.Case","id":2955},{"type":"DG.Case","id":2956},{"type":"DG.Case","id":2958},{"type":"DG.Case","id":2966},{"type":"DG.Case","id":2971},{"type":"DG.Case","id":3006},{"type":"DG.Case","id":3010},{"type":"DG.Case","id":3016},{"type":"DG.Case","id":3017},{"type":"DG.Case","id":3018},{"type":"DG.Case","id":3020},{"type":"DG.Case","id":3022},{"type":"DG.Case","id":3026},{"type":"DG.Case","id":3041},{"type":"DG.Case","id":3042},{"type":"DG.Case","id":3054},{"type":"DG.Case","id":3056},{"type":"DG.Case","id":3058},{"type":"DG.Case","id":3059},{"type":"DG.Case","id":3060},{"type":"DG.Case","id":3062},{"type":"DG.Case","id":3077},{"type":"DG.Case","id":3078},{"type":"DG.Case","id":3087},{"type":"DG.Case","id":3090},{"type":"DG.Case","id":3100},{"type":"DG.Case","id":3105},{"type":"DG.Case","id":3106},{"type":"DG.Case","id":3116},{"type":"DG.Case","id":3117},{"type":"DG.Case","id":3118},{"type":"DG.Case","id":3120},{"type":"DG.Case","id":3123},{"type":"DG.Case","id":3124},{"type":"DG.Case","id":3126},{"type":"DG.Case","id":3127},{"type":"DG.Case","id":3128},{"type":"DG.Case","id":3135},{"type":"DG.Case","id":3138},{"type":"DG.Case","id":3144},{"type":"DG.Case","id":3145},{"type":"DG.Case","id":3146},{"type":"DG.Case","id":3147},{"type":"DG.Case","id":3153},{"type":"DG.Case","id":3154},{"type":"DG.Case","id":3157},{"type":"DG.Case","id":3166},{"